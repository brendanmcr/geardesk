{
  "name": "geardesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inventory management for small operations: TypeScript, Postgres, CSV import/export.",
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.11.0"
  }
}
